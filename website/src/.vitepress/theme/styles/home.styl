/**
 * Home hero with comparison slider
 * --------------------------------------------------------------------------
 */

.VPHero.has-image {
  .container {
    align-items: center
  }

  .main {
    max-width: 560px
  }

  .image {
    margin: 0
    display: flex
    align-items: center
    justify-content: center
  }

  .image-container {
    width: 100%
    max-width: 440px
    height: auto
    transform: none !important
  }

  .image-bg {
    display: none
  }
}

@media (max-width: 959px) {
  .VPHero.has-image {
    .container {
      text-align: center
    }

    .main {
      order: 1
      margin: 0 auto
    }

    .image {
      order: 2
      margin-top: 36px
    }

    .image-container {
      max-width: 380px
      height: auto
      margin: 0 auto
      transform: none !important
    }
  }
}


